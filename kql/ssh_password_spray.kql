// SSH Password Spray
// Generated from rules/linux/sshd/ssh_password_spray.yml by `python -m soclab.kql`. Do not edit by hand.
// Level: high | ATT&CK: T1110.003 | Schema: Microsoft Sentinel ASIM
imAuthentication
| where EventType =~ "Logon" and EventResult =~ "Failure" and not(TargetUsername =~ "svc_backup" and ipv4_is_in_range(SrcIpAddr, "10.20.0.0/24"))
| summarize ValueCount = dcount(TargetUsername) by bin(TimeGenerated, 30m), SrcIpAddr
| where ValueCount >= 10
