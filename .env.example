# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# Leave a key empty to use recorded mock responses for that provider.

ABUSEIPDB_API_KEY=      # https://www.abuseipdb.com/register  (free: 1,000 checks/day)
VIRUSTOTAL_API_KEY=     # https://www.virustotal.com/gui/join-us (free: 4 req/min, 500/day)
OTX_API_KEY=            # https://otx.alienvault.com/ (free)

# 1 = never call external APIs (CI uses this)
SOCLAB_OFFLINE=0

# Response playbooks only log what they WOULD do unless this is set to false
SOCLAB_DRY_RUN=true
